        </mxCell>
        <mxCell id="dm" value="deriveMessages()&lt;br&gt;→ 下次模型请求" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;" vertex="1" parent="1">
